# Copy this file to .env and adjust as needed.
# .env is git-ignored — safe to keep real/local values there.

# Base URL of the backend API (no trailing slash), e.g. http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Legacy fallback base URL used for images that predate Cloudinary storage
# (current uploads are stored as full https:// Cloudinary URLs and don't need this).
VITE_IMG_URL=http://localhost:5000/uploads
