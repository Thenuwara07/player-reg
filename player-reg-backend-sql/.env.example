# Copy this file to .env and fill in the real values.
# .env is git-ignored — never commit real secrets.

# Port the API listens on.
PORT=5000

# MySQL connection string used by Prisma.
# mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# Secret used to sign/verify JWTs. Use a long random string in every
# environment (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=

# Cloudinary account used to store uploaded images (profile pictures, ID
# scans, post images).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional — defaults to "player-reg/uploads" if unset.
CLOUDINARY_FOLDER=player-reg/uploads
